# Copy this to .env and fill in your values

# ── Hyperliquid ────────────────────────────────────────────────────────────────
# Get these from your Hyperliquid account (Settings → API Keys)
# For testnet: create wallet at app.hyperliquid-testnet.xyz
WALLET_ADDRESS=0xYourWalletAddressHere
PRIVATE_KEY=0xYourPrivateKeyHere

# ── Dashboard (Vercel) ────────────────────────────────────────────────────────
DASHBOARD_URL=https://your-app.vercel.app
BOT_SECRET=your-secret-here

# ── Upstash Redis (for dashboard) ─────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token-here
